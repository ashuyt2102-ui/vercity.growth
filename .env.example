# Vercity Growth Environment Variables

# Supabase (Optional for local testing without cloud account, form falls back to simulated verified save if not configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend for Email Notifications (Optional for local testing)
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_NOTIFICATION_EMAIL=admin@vercitygrowth.com
FROM_EMAIL=onboarding@resend.dev

# Google Gemini (required for live AI chat; keep this server-side and never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-2.5-flash
